package logdb

import "core:crypto/sha2"
import "core:fmt"
import "core:os"
import "core:testing"

// Golden fingerprint of the on-disk part format. The corpus is fixed (rows,
// block size, field names, values, timestamps), so data.bin / bloom.bin /
// index.bin must hash to the same values forever: encode is allowed to get
// faster, never to change what it writes. meta.json is excluded because it
// carries created_ns.
//
// Regenerating these constants is a format change, not a refactor: update them
// only together with a deliberate version bump and a docs/benchmarks.md note.
GOLDEN_ROW_STREAMS :: 3
GOLDEN_ROWS_PER_STREAM :: 40
GOLDEN_BLOCK_ROWS :: 16

GOLDEN_DATA_SHA256 :: "7927ae0d92f889d4cade54efe411304fe0eab1868869ac92297959c0a3856f2d"
GOLDEN_BLOOM_SHA256 :: "56d0e2b17f3e622f1ea85d419e986f3803ce59a6b485a0f49eaf957d36e93e53"
GOLDEN_INDEX_SHA256 :: "1f0413538ef30352d3c6a80ee70a9ab11fb022d6fa1c1ee3327e9e4f52a95abc"
GOLDEN_DATA_BYTES :: 3812
GOLDEN_BLOOM_BYTES :: 1920
GOLDEN_INDEX_BYTES :: 588

// golden_rows builds a deterministic corpus: two fields are constant per
// stream (zone), one changes slowly (level), the rest vary per row, so the
// golden bytes cover both the const-column and the per-value paths.
@(private)
golden_rows :: proc() -> []Row {
	levels := [4]string{"error", "info", "warn", "debug"}
	services := [4]string{"api", "db", "cache", "auth"}
	zones := [3]string{"a", "b", "c"}
	base_ts := i64(1_700_000_000_000_000_000)
	rows := make([]Row, GOLDEN_ROW_STREAMS * GOLDEN_ROWS_PER_STREAM)
	k := 0
	for s in 1 ..= GOLDEN_ROW_STREAMS {
		for i in 0 ..< GOLDEN_ROWS_PER_STREAM {
			f := make([]Field, 5)
			f[0] = Field{name = "level", value = fmt.aprintf("%s", levels[(i / 8) % 4])}
			f[1] = Field{name = "service", value = fmt.aprintf("%s", services[i % 4])}
			f[2] = Field{name = "zone", value = fmt.aprintf("%s", zones[s - 1])}
			f[3] = Field{name = "host", value = fmt.aprintf("host-%03d", (i * 7) % 4096)}
			f[4] = Field{name = "duration", value = fmt.aprintf("%d", (i * 37) % 5000)}
			rows[k] = Row{
				ts     = base_ts + i64(i) * 1000,
				stream = u64(s),
				msg    = fmt.aprintf("request id=%d path=/api/v1/items/%d status=%d", i % 32, i * 7, 200 + i % 3 * 100),
				fields = f,
			}
			k += 1
		}
	}
	return rows
}

@(private)
golden_rows_destroy :: proc(rows: []Row) {
	for &r in rows {
		for f in r.fields {
			delete(f.value)
		}
		delete(r.fields)
		delete(r.msg)
	}
	delete(rows)
}

// golden_sha256 fills hex with the lowercase hex SHA-256 of the file contents.
@(private)
golden_sha256 :: proc(path: string, hex: ^[64]u8) -> (n: int, ok: bool) {
	data, err := os.read_entire_file_from_path(path, context.allocator)
	if err != nil {
		return 0, false
	}
	defer delete(data)
	ctx: sha2.Context_256
	sha2.init_256(&ctx)
	sha2.update(&ctx, data)
	sum: [32]u8
	sha2.final(&ctx, sum[:])
	for x, i in sum {
		hi := u8(x >> 4)
		lo := u8(x & 0xf)
		hex[i * 2] = hi < 10 ? '0' + hi : 'a' + hi - 10
		hex[i * 2 + 1] = lo < 10 ? '0' + lo : 'a' + lo - 10
	}
	return len(data), true
}

// test_part_golden_bytes_sha256 pins every byte the encoder writes. The SHA-256
// constants were generated by the pre-optimisation encoder; a mismatch means
// the on-disk format or its content changed, which is never acceptable for a
// pure speed change.
@(test)
test_part_golden_bytes_sha256 :: proc(t: ^testing.T) {
	dir := "/tmp/oboe_golden_part"
	os.remove_all(dir)
	defer os.remove_all(dir)

	rows := golden_rows()
	defer golden_rows_destroy(rows)
	p, ok := write_part(dir, rows, GOLDEN_BLOCK_ROWS)
	if !ok {
		testing.fail_now(t, "write_part failed")
	}
	testing.expect_value(t, p.meta.rows, len(rows))
	close_part(p)

	paths := [3]string{"data.bin", "bloom.bin", "index.bin"}
	expect_sha := [3]string{GOLDEN_DATA_SHA256, GOLDEN_BLOOM_SHA256, GOLDEN_INDEX_SHA256}
	expect_len := [3]int{GOLDEN_DATA_BYTES, GOLDEN_BLOOM_BYTES, GOLDEN_INDEX_BYTES}
	for name, i in paths {
		path := fmt.aprintf("%s/%s", dir, name)
		defer delete(path)
		hex: [64]u8
		n, hok := golden_sha256(path, &hex)
		if !hok {
			testing.fail_now(t, fmt.tprintf("could not hash %s", name))
		}
		testing.expect_value(t, string(hex[:]), expect_sha[i])
		testing.expect_value(t, n, expect_len[i])
	}
	testing.expect_value(t, p.meta.data_size, i64(expect_len[0]))
	testing.expect_value(t, p.meta.bloom_size, i64(expect_len[1]))
	testing.expect_value(t, p.meta.index_size, i64(expect_len[2]))
}
