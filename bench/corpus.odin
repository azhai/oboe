// Synthetic log corpus shared by every benchmark. The shape matches the NDJSON
// files generated by bench/run_matrix.sh so library and HTTP numbers are
// comparable: level, service, zone, host, user and duration fields, with
// timestamps spread over a 10 minute window.
package main

import "core:fmt"

import "../logdb"

HOSTS :: 4096
USERS :: 8192
DURATIONS :: 256
SPREAD_NS :: i64(10 * 60 * 1_000_000_000)
FIELDS_PER_ROW :: 6

Corpus :: struct {
	msgs:      []string,
	levels:    [4]string,
	services:  [4]string,
	zones:     [3]string,
	hosts:     []string,
	users:     []string,
	durations: []string,
}

corpus_make :: proc() -> Corpus {
	c := Corpus{
		msgs      = make([]string, 32),
		levels    = [4]string{"error", "info", "warn", "debug"},
		services  = [4]string{"api", "db", "cache", "auth"},
		zones     = [3]string{"a", "b", "c"},
		hosts     = make([]string, HOSTS),
		users     = make([]string, USERS),
		durations = make([]string, DURATIONS),
	}
	for i in 0..<len(c.msgs) {
		c.msgs[i] = fmt.aprintf(
			"request id=%d path=/api/v1/items/%d status=%d latency=%dms peer=10.0.%d.%d",
			i,
			i * 7,
			200 + i % 3 * 100,
			i % 250,
			i % 16,
			(i * 3) % 255,
		)
	}
	for i in 0..<HOSTS {
		c.hosts[i] = fmt.aprintf("host-%03d", i)
	}
	for i in 0..<USERS {
		c.users[i] = fmt.aprintf("user-%04d", i)
	}
	for i in 0..<DURATIONS {
		c.durations[i] = fmt.aprintf("%d", (i * 37) % 5000)
	}
	return c
}

corpus_destroy :: proc(c: ^Corpus) {
	for s in c.msgs {
		delete(s)
	}
	delete(c.msgs)
	for s in c.hosts {
		delete(s)
	}
	delete(c.hosts)
	for s in c.users {
		delete(s)
	}
	delete(c.users)
	for s in c.durations {
		delete(s)
	}
	delete(c.durations)
	c^ = {}
}

// row_ts spreads `index` of `total` rows over the corpus window.
row_ts :: proc(base_ts: i64, index, total: int) -> i64 {
	if total <= 0 {
		return base_ts
	}
	return base_ts + i64(index) * SPREAD_NS / i64(total)
}

// corpus_fill_row writes one row into f (which must have FIELDS_PER_ROW
// entries) and returns a Row referencing the corpus strings. The field layout
// matches the one bench/ingest.odin uses when seeding.
corpus_fill_row :: proc(c: ^Corpus, gi, total: int, base_ts: i64, f: []logdb.Field) -> logdb.Row {
	f[0] = logdb.Field{name = "level", value = c.levels[gi % 4]}
	f[1] = logdb.Field{name = "service", value = c.services[gi % 4]}
	f[2] = logdb.Field{name = "zone", value = c.zones[gi % 3]}
	f[3] = logdb.Field{name = "host", value = c.hosts[gi % HOSTS]}
	f[4] = logdb.Field{name = "user", value = c.users[gi % USERS]}
	f[5] = logdb.Field{name = "duration", value = c.durations[gi % DURATIONS]}
	return logdb.Row{
		ts     = row_ts(base_ts, gi, total),
		stream = u64(gi % 4 + 1),
		msg    = c.msgs[gi % len(c.msgs)],
		fields = f[:FIELDS_PER_ROW],
	}
}
